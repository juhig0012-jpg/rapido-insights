import pandas as pd

bookings = pd.read_csv("data/raw/bookings.csv")
customers = pd.read_csv("data/raw/customers.csv")
drivers = pd.read_csv("data/raw/drivers.csv")
location = pd.read_csv("data/raw/location_demand.csv")
time_df = pd.read_csv("data/raw/time_features.csv")

for name, df in {
    "bookings": bookings,
    "customers": customers,
    "drivers": drivers,
    "location": location,
    "time_features": time_df
}.items():
    print(f"\n{name.upper()}")
    print(df.head())
    print(df.shape)
    print(df.info())
    print(df.isnull().sum())